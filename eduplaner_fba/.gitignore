# Dokumenty składane pod konkretnego ucznia noszą jego imię i punktację
# kwestionariusza — to dane osobowe, nie materiał do repozytorium.
# W repozytorium zostaje sam formularz bez nazwiska i tabela celów.
Cele_SMART_FBA_*
!Cele_SMART_FBA_obserwacja_poglebiona.html
!Cele_SMART_FBA_obserwacja_poglebiona.pdf

# Surowe pliki z modelu i nagrania jej głosem. Nagranie głosu to dana
# biometryczna — do repozytorium wchodzi tylko skompresowany JPG ilustracji,
# a nagrania i surowe PNG zostają na dysku.
assets/**/*.png
assets/**/*.mp3
