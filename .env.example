# Skopiuj do .env (jest w .gitignore) albo — lepiej — wyeksportuj w ~/.zshrc / ~/.bashrc.
# Nigdy nie commituj prawdziwych kluczy.

# HeyGen — awatar i wideo. Klucz: app.heygen.com → Settings → API → New Key
# UWAGA: ustawienie tej zmiennej wyłącza wykrywanie MCP w skillach HeyGen.
HEYGEN_API_KEY=

# Opcjonalnie: identyfikatory z pliku AVATAR-<IMIĘ>.md, żeby nie podawać ich za każdym razem
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=

# ElevenLabs — klon głosu i TTS (używa skill dane-i-glos oraz .mcp.json)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
