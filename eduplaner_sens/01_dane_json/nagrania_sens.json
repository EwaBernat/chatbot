  "nagrania": [
    {
      "id": "POL-SENS-01-III",
      "wskaznik_id": "SENS-01",
      "poziom_wsparcia": "III",
      "tekst": "Za jasno. Stawiamy parawan. Robimy to razem.",
      "plik": "04_media/eduplaner_sens/assets/audio_sens/as_01_III.mp3",
      "czyta": "sklonowany głos autorki (dana biometryczna)"
    },
    {
      "id": "POL-SENS-01-II",
      "wskaznik_id": "SENS-01",
      "poziom_wsparcia": "II",
      "tekst": "Popatrz na kartę. Za jasno? Postaw parawan i wracaj do układanki.",
      "plik": "04_media/eduplaner_sens/assets/audio_sens/as_01_II.mp3",
      "czyta": "sklonowany głos autorki (dana biometryczna)"
    },
    {
      "id": "POL-SENS-01-I",
      "wskaznik_id": "SENS-01",
      "poziom_wsparcia": "I",
      "tekst": "Zanim zaczniesz, ustaw sobie miejsce dla oczu.",
      "plik": "04_media/eduplaner_sens/assets/audio_sens/as_01_I.mp3",
      "czyta": "sklonowany głos autorki (dana biometryczna)"
    },
    {
      "id": "POL-SENS-02-III",
      "wskaznik_id": "SENS-02",
      "poziom_wsparcia": "III",
      "tekst": "Światełka są tutaj. Patrzymy razem. Liczę do dwudziestu.",
      "plik": "04_media/eduplaner_sens/assets/audio_sens/as_02_III.mp3",
      "czyta": "sklonowany głos autorki (dana biometryczna)"
    },
    {
      "id": "POL-SENS-02-II",
      "wskaznik_id": "SENS-02",
      "poziom_wsparcia": "II",
      "tekst": "Chcesz światełka? Podaj kartę i idź do półki.",
      "plik": "04_media/eduplaner_sens/assets/audio_sens/as_02_II.mp3",
      "czyta": "sklonowany głos autorki (dana biometryczna)"
    },
    {
      "id": "POL-SENS-02-I",
      "wskaznik_id": "SENS-02",
      "poziom_wsparcia": "I",
      "tekst": "Weź okienko. Prowadź od lewej strony.",
      "plik": "04_media/eduplaner_sens/assets/audio_sens/as_02_I.mp3",
      "czyta": "sklonowany głos autorki (dana biometryczna)"
    },
    {
      "id": "POL-SENS-03-III",
      "wskaznik_id": "SENS-03",
      "poziom_wsparcia": "III",
      "tekst": "Jak dziś mają się twoje oczy? Przypinamy klamerkę razem.",
      "plik": "04_media/eduplaner_sens/assets/audio_sens/as_03_III.mp3",
      "czyta": "sklonowany głos autorki (dana biometryczna)"
    },
    {
      "id": "POL-SENS-03-II",
      "wskaznik_id": "SENS-03",
      "poziom_wsparcia": "II",
      "tekst": "Przypnij klamerkę. Zielone, żółte czy czerwone?",
      "plik": "04_media/eduplaner_sens/assets/audio_sens/as_03_II.mp3",
      "czyta": "sklonowany głos autorki (dana biometryczna)"
    },
    {
      "id": "POL-SENS-03-I",
      "wskaznik_id": "SENS-03",
      "poziom_wsparcia": "I",
      "tekst": "Ustaw termometr i powiedz, gdzie dziś siadasz.",
      "plik": "04_media/eduplaner_sens/assets/audio_sens/as_03_I.mp3",
      "czyta": "sklonowany głos autorki (dana biometryczna)"
    },
    {
      "id": "POL-SENS-04-III",
      "wskaznik_id": "SENS-04",
      "poziom_wsparcia": "III",
      "tekst": "Za głośno. Zakładamy słuchawki. Jestem obok.",
      "plik": "04_media/eduplaner_sens/assets/audio_sens/as_04_III.mp3",
      "czyta": "sklonowany głos autorki (dana biometryczna)"
    },
    {
      "id": "POL-SENS-04-II",
      "wskaznik_id": "SENS-04",
      "poziom_wsparcia": "II",
      "tekst": "Za chwilę szatnia. Weź słuchawki z wieszaka.",
      "plik": "04_media/eduplaner_sens/assets/audio_sens/as_04_II.mp3",
      "czyta": "sklonowany głos autorki (dana biometryczna)"
    },
    {
      "id": "POL-SENS-04-I",
      "wskaznik_id": "SENS-04",
      "poziom_wsparcia": "I",
      "tekst": "Zaraz będzie głośno. Zdecyduj, co robisz.",
      "plik": "04_media/eduplaner_sens/assets/audio_sens/as_04_I.mp3",
      "czyta": "sklonowany głos autorki (dana biometryczna)"
    },
    {
      "id": "POL-SENS-05-III",
      "wskaznik_id": "SENS-05",
      "poziom_wsparcia": "III",
      "tekst": "Popatrz na mnie. Jestem tu. Idziemy po bębenek razem.",
      "plik": "04_media/eduplaner_sens/assets/audio_sens/as_05_III.mp3",
      "czyta": "sklonowany głos autorki (dana biometryczna)"
    },
    {
      "id": "POL-SENS-05-II",
      "wskaznik_id": "SENS-05",
      "poziom_wsparcia": "II",
      "tekst": "Podaj kartę. Dwie minuty z instrumentem, potem wracamy.",
      "plik": "04_media/eduplaner_sens/assets/audio_sens/as_05_II.mp3",
      "czyta": "sklonowany głos autorki (dana biometryczna)"
    },
    {
      "id": "POL-SENS-05-I",
      "wskaznik_id": "SENS-05",
      "poziom_wsparcia": "I",
      "tekst": "Powiedz, kiedy zrobisz sobie przerwę na dźwięki.",
      "plik": "04_media/eduplaner_sens/assets/audio_sens/as_05_I.mp3",
      "czyta": "sklonowany głos autorki (dana biometryczna)"
    },
    {
      "id": "POL-SENS-06-III",
      "wskaznik_id": "SENS-06",
      "poziom_wsparcia": "III",
      "tekst": "Sprawdzamy uszy. Ustawiam strzałkę z tobą.",
      "plik": "04_media/eduplaner_sens/assets/audio_sens/as_06_III.mp3",
      "czyta": "sklonowany głos autorki (dana biometryczna)"
    },
    {
      "id": "POL-SENS-06-II",
      "wskaznik_id": "SENS-06",
      "poziom_wsparcia": "II",
      "tekst": "Ustaw strzałkę. Co dziś wybierasz?",
      "plik": "04_media/eduplaner_sens/assets/audio_sens/as_06_II.mp3",
      "czyta": "sklonowany głos autorki (dana biometryczna)"
    },
    {
      "id": "POL-SENS-06-I",
      "wskaznik_id": "SENS-06",
      "poziom_wsparcia": "I",
      "tekst": "Ustaw radio uszu i powiedz, co z niego wynika.",
      "plik": "04_media/eduplaner_sens/assets/audio_sens/as_06_I.mp3",
      "czyta": "sklonowany głos autorki (dana biometryczna)"
    },
    {
      "id": "POL-SENS-07-III",
      "wskaznik_id": "SENS-07",
      "poziom_wsparcia": "III",
      "tekst": "Stajemy na stópkach. Ja jestem obok ciebie.",
      "plik": "04_media/eduplaner_sens/assets/audio_sens/as_07_III.mp3",
      "czyta": "sklonowany głos autorki (dana biometryczna)"
    },
    {
      "id": "POL-SENS-07-II",
      "wskaznik_id": "SENS-07",
      "poziom_wsparcia": "II",
      "tekst": "Twoje miejsce jest na stópkach. Masz kartę „NIE TERAZ”.",
      "plik": "04_media/eduplaner_sens/assets/audio_sens/as_07_II.mp3",
      "czyta": "sklonowany głos autorki (dana biometryczna)"
    },
    {
      "id": "POL-SENS-07-I",
      "wskaznik_id": "SENS-07",
      "poziom_wsparcia": "I",
      "tekst": "Wybierz miejsce, zanim ustawimy się w kolejce.",
      "plik": "04_media/eduplaner_sens/assets/audio_sens/as_07_I.mp3",
      "czyta": "sklonowany głos autorki (dana biometryczna)"
    },
    {
      "id": "POL-SENS-08-III",
      "wskaznik_id": "SENS-08",
      "poziom_wsparcia": "III",
      "tekst": "Ręce na gniotka. Trzymamy razem. Siedzimy do końca piosenki.",
      "plik": "04_media/eduplaner_sens/assets/audio_sens/as_08_III.mp3",
      "czyta": "sklonowany głos autorki (dana biometryczna)"
    },
    {
      "id": "POL-SENS-08-II",
      "wskaznik_id": "SENS-08",
      "poziom_wsparcia": "II",
      "tekst": "Weź gniotka do ręki. Ręce pracują tutaj.",
      "plik": "04_media/eduplaner_sens/assets/audio_sens/as_08_II.mp3",
      "czyta": "sklonowany głos autorki (dana biometryczna)"
    },
    {
      "id": "POL-SENS-08-I",
      "wskaznik_id": "SENS-08",
      "poziom_wsparcia": "I",
      "tekst": "Przygotuj ręce, zanim usiądziemy w kręgu.",
      "plik": "04_media/eduplaner_sens/assets/audio_sens/as_08_I.mp3",
      "czyta": "sklonowany głos autorki (dana biometryczna)"
    },
    {
      "id": "POL-SENS-09-III",
      "wskaznik_id": "SENS-09",
      "poziom_wsparcia": "III",
      "tekst": "Pokaż, co dziś drapie. Wybieramy ubranie razem.",
      "plik": "04_media/eduplaner_sens/assets/audio_sens/as_09_III.mp3",
      "czyta": "sklonowany głos autorki (dana biometryczna)"
    },
    {
      "id": "POL-SENS-09-II",
      "wskaznik_id": "SENS-09",
      "poziom_wsparcia": "II",
      "tekst": "Wskaż na pasku: jeden, dwa czy trzy?",
      "plik": "04_media/eduplaner_sens/assets/audio_sens/as_09_II.mp3",
      "czyta": "sklonowany głos autorki (dana biometryczna)"
    },
    {
      "id": "POL-SENS-09-I",
      "wskaznik_id": "SENS-09",
      "poziom_wsparcia": "I",
      "tekst": "Ustal swój poziom i powiedz, czego dziś nie chcesz dotykać.",
      "plik": "04_media/eduplaner_sens/assets/audio_sens/as_09_I.mp3",
      "czyta": "sklonowany głos autorki (dana biometryczna)"
    },
    {
      "id": "POL-SENS-10-III",
      "wskaznik_id": "SENS-10",
      "poziom_wsparcia": "III",
      "tekst": "Patrzymy na nowe jedzenie. Nie musisz jeść. Dotykam widelcem, zrób tak samo.",
      "plik": "04_media/eduplaner_sens/assets/audio_sens/as_10_III.mp3",
      "czyta": "sklonowany głos autorki (dana biometryczna)"
    },
    {
      "id": "POL-SENS-10-II",
      "wskaznik_id": "SENS-10",
      "poziom_wsparcia": "II",
      "tekst": "Pokaż na drabinie, gdzie dziś jesteś. Zrób ten jeden szczebel.",
      "plik": "04_media/eduplaner_sens/assets/audio_sens/as_10_II.mp3",
      "czyta": "sklonowany głos autorki (dana biometryczna)"
    },
    {
      "id": "POL-SENS-10-I",
      "wskaznik_id": "SENS-10",
      "poziom_wsparcia": "I",
      "tekst": "Wybierz swój szczebel na dziś i powiedz mi, kiedy skończysz.",
      "plik": "04_media/eduplaner_sens/assets/audio_sens/as_10_I.mp3",
      "czyta": "sklonowany głos autorki (dana biometryczna)"
    },
    {
      "id": "POL-SENS-11-III",
      "wskaznik_id": "SENS-11",
      "poziom_wsparcia": "III",
      "tekst": "Buzia chce mocno. Bierzemy gryzak. Kredka zostaje na stole.",
      "plik": "04_media/eduplaner_sens/assets/audio_sens/as_11_III.mp3",
      "czyta": "sklonowany głos autorki (dana biometryczna)"
    },
    {
      "id": "POL-SENS-11-II",
      "wskaznik_id": "SENS-11",
      "poziom_wsparcia": "II",
      "tekst": "Weź gryzak, nie rękaw. Napij się przez rurkę.",
      "plik": "04_media/eduplaner_sens/assets/audio_sens/as_11_II.mp3",
      "czyta": "sklonowany głos autorki (dana biometryczna)"
    },
    {
      "id": "POL-SENS-11-I",
      "wskaznik_id": "SENS-11",
      "poziom_wsparcia": "I",
      "tekst": "Przygotuj buzię przed zadaniem — wiesz, co robić.",
      "plik": "04_media/eduplaner_sens/assets/audio_sens/as_11_I.mp3",
      "czyta": "sklonowany głos autorki (dana biometryczna)"
    },
    {
      "id": "POL-SENS-12-III",
      "wskaznik_id": "SENS-12",
      "poziom_wsparcia": "III",
      "tekst": "Wybieramy kartę. Jem swoje, próbuję czy tylko patrzę?",
      "plik": "04_media/eduplaner_sens/assets/audio_sens/as_12_III.mp3",
      "czyta": "sklonowany głos autorki (dana biometryczna)"
    },
    {
      "id": "POL-SENS-12-II",
      "wskaznik_id": "SENS-12",
      "poziom_wsparcia": "II",
      "tekst": "Połóż kartę przed jedzeniem.",
      "plik": "04_media/eduplaner_sens/assets/audio_sens/as_12_II.mp3",
      "czyta": "sklonowany głos autorki (dana biometryczna)"
    },
    {
      "id": "POL-SENS-12-I",
      "wskaznik_id": "SENS-12",
      "poziom_wsparcia": "I",
      "tekst": "Wybierz kartę i powiedz, co dziś jest inaczej.",
      "plik": "04_media/eduplaner_sens/assets/audio_sens/as_12_I.mp3",
      "czyta": "sklonowany głos autorki (dana biometryczna)"
    },
    {
      "id": "POL-SENS-13-III",
      "wskaznik_id": "SENS-13",
      "poziom_wsparcia": "III",
      "tekst": "Brzydki zapach. Dajemy chusteczkę do nosa. Wchodzimy razem.",
      "plik": "04_media/eduplaner_sens/assets/audio_sens/as_13_III.mp3",
      "czyta": "sklonowany głos autorki (dana biometryczna)"
    },
    {
      "id": "POL-SENS-13-II",
      "wskaznik_id": "SENS-13",
      "poziom_wsparcia": "II",
      "tekst": "Weź chusteczkę z kieszeni. Usiądź przy oknie.",
      "plik": "04_media/eduplaner_sens/assets/audio_sens/as_13_II.mp3",
      "czyta": "sklonowany głos autorki (dana biometryczna)"
    },
    {
      "id": "POL-SENS-13-I",
      "wskaznik_id": "SENS-13",
      "poziom_wsparcia": "I",
      "tekst": "Powiedz, gdzie dziś siadasz w stołówce.",
      "plik": "04_media/eduplaner_sens/assets/audio_sens/as_13_I.mp3",
      "czyta": "sklonowany głos autorki (dana biometryczna)"
    },
    {
      "id": "POL-SENS-14-III",
      "wskaznik_id": "SENS-14",
      "poziom_wsparcia": "III",
      "tekst": "Wąchamy tutaj. To jest pudełko zapachów. Idziemy razem.",
      "plik": "04_media/eduplaner_sens/assets/audio_sens/as_14_III.mp3",
      "czyta": "sklonowany głos autorki (dana biometryczna)"
    },
    {
      "id": "POL-SENS-14-II",
      "wskaznik_id": "SENS-14",
      "poziom_wsparcia": "II",
      "tekst": "Podaj kartę i idź do pudełka. Dwie minuty.",
      "plik": "04_media/eduplaner_sens/assets/audio_sens/as_14_II.mp3",
      "czyta": "sklonowany głos autorki (dana biometryczna)"
    },
    {
      "id": "POL-SENS-14-I",
      "wskaznik_id": "SENS-14",
      "poziom_wsparcia": "I",
      "tekst": "Powiedz, kiedy dziś pójdziesz powąchać.",
      "plik": "04_media/eduplaner_sens/assets/audio_sens/as_14_I.mp3",
      "czyta": "sklonowany głos autorki (dana biometryczna)"
    },
    {
      "id": "POL-SENS-15-III",
      "wskaznik_id": "SENS-15",
      "poziom_wsparcia": "III",
      "tekst": "Sprawdzamy nos. Wąchamy woreczek. Którą buźkę wybierasz?",
      "plik": "04_media/eduplaner_sens/assets/audio_sens/as_15_III.mp3",
      "czyta": "sklonowany głos autorki (dana biometryczna)"
    },
    {
      "id": "POL-SENS-15-II",
      "wskaznik_id": "SENS-15",
      "poziom_wsparcia": "II",
      "tekst": "Powąchaj oba woreczki i wskaż buźkę.",
      "plik": "04_media/eduplaner_sens/assets/audio_sens/as_15_II.mp3",
      "czyta": "sklonowany głos autorki (dana biometryczna)"
    },
    {
      "id": "POL-SENS-15-I",
      "wskaznik_id": "SENS-15",
      "poziom_wsparcia": "I",
      "tekst": "Sprawdź nos dnia i powiedz, czego dziś potrzebujesz.",
      "plik": "04_media/eduplaner_sens/assets/audio_sens/as_15_I.mp3",
      "czyta": "sklonowany głos autorki (dana biometryczna)"
    },
    {
      "id": "POL-SENS-16-III",
      "wskaznik_id": "SENS-16",
      "poziom_wsparcia": "III",
      "tekst": "Pchamy pudło razem. Ja z jednej strony, ty z drugiej.",
      "plik": "04_media/eduplaner_sens/assets/audio_sens/as_16_III.mp3",
      "czyta": "sklonowany głos autorki (dana biometryczna)"
    },
    {
      "id": "POL-SENS-16-II",
      "wskaznik_id": "SENS-16",
      "poziom_wsparcia": "II",
      "tekst": "Wskaż szczebel na drabinie i zrób go.",
      "plik": "04_media/eduplaner_sens/assets/audio_sens/as_16_II.mp3",
      "czyta": "sklonowany głos autorki (dana biometryczna)"
    },
    {
      "id": "POL-SENS-16-I",
      "wskaznik_id": "SENS-16",
      "poziom_wsparcia": "I",
      "tekst": "Wybierz dziś swój szczebel i powiedz, gdzie poczułeś mięśnie.",
      "plik": "04_media/eduplaner_sens/assets/audio_sens/as_16_I.mp3",
      "czyta": "sklonowany głos autorki (dana biometryczna)"
    },
    {
      "id": "POL-SENS-17-III",
      "wskaznik_id": "SENS-17",
      "poziom_wsparcia": "III",
      "tekst": "Twoje ciało chce mocno. Idziemy po kocyk. Liczę do stu.",
