      "wskaznik_id": "SENS-18",
      "poziom_wsparcia": "II",
      "tekst": "Zrób trzy kreski na mierniku. Która jest w sam raz?",
      "plik": "04_media/eduplaner_sens/assets/audio_sens/as_18_II.mp3",
      "czyta": "sklonowany głos autorki (dana biometryczna)"
    },
    {
      "id": "POL-SENS-18-I",
      "wskaznik_id": "SENS-18",
      "poziom_wsparcia": "I",
