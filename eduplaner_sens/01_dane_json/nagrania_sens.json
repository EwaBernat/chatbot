      "czyta": "sklonowany głos autorki (dana biometryczna)"
    },
    {
      "id": "POL-SENS-17-II",
      "wskaznik_id": "SENS-17",
      "poziom_wsparcia": "II",
      "tekst": "Podaj kartę „MOCNO” i idź do kącika. Trzy minuty.",
      "plik": "04_media/eduplaner_sens/assets/audio_sens/as_17_II.mp3",
      "czyta": "sklonowany głos autorki (dana biometryczna)"
    },
    {
      "id": "POL-SENS-17-I",
      "wskaznik_id": "SENS-17",
      "poziom_wsparcia": "I",
      "tekst": "Powiedz, kiedy robisz dziś przerwę na docisk.",
      "plik": "04_media/eduplaner_sens/assets/audio_sens/as_17_I.mp3",
      "czyta": "sklonowany głos autorki (dana biometryczna)"
    },
    {
      "id": "POL-SENS-18-III",
      "wskaznik_id": "SENS-18",
      "poziom_wsparcia": "III",
      "tekst": "Robimy trzy kreski. Piórko, w sam raz, za mocno. Prowadzę twoją rękę.",
