{
  "name": "ocena-funkcjonalna-film",
  "version": "1.0.0",
  "private": true,
  "description": "Render MP4 filmu „Ocena Funkcjonalna” (druk + Twój głos z ElevenLabs + Twój awatar z HeyGen)",
  "scripts": {
    "start": "remotion studio",
    "render": "remotion render OcenaFunkcjonalna ../out/film.mp4",
    "still": "remotion still OcenaFunkcjonalna ../out/klatka.png --frame=900",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.400",
    "@remotion/media-utils": "4.0.400",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.400"
  },
  "devDependencies": {
    "@types/react": "19.2.0",
    "typescript": "5.9.3"
  }
}
